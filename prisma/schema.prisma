generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1:1 맞짱 방. 초대 링크(inviteToken)로 친구를 초대해서 최대 2명까지 들어옴
model Room {
  id          String   @id @default(cuid())
  inviteToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  // 벌금을 모으는 모임 통장 (개인 계좌가 아니라 방 하나당 공용 계좌 하나)
  groupBankName      String?
  groupAccountNumber String?
  groupAccountHolder String?

  // 방 삭제 요청 (상호 동의 방식)
  deleteRequestedBy String? // 삭제 요청한 userId

  // 일시정지 (상호 동의 방식)
  pauseRequestedBy    String?   // 정지 요청한 userId
  pauseRequestedUntil DateTime? // 요청된 정지 종료일 (= 다시 시작하는 주의 월요일 00:00 KST 키)
  pauseReason         String?   // 쉬어가려는 사유
  pausedUntil         DateTime? // 확정된 정지 종료일 = 다시 시작하는 주의 월요일 (null이면 정지 아님)

  users  User[]
  pauses RoomPause[]
}

// 확정된 쉬어가기 이력. fromWeek <= 주 < untilWeek 인 주는 두 사람 모두 벌금이 없다 (모두 주 월요일 00:00 KST 키)
model RoomPause {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromWeek  DateTime
  untilWeek DateTime
  createdAt DateTime @default(now())

  @@index([roomId])
}

// 요청한 사람 혼자 쉬는 기간 이력. fromWeek <= 주 < untilWeek 인 주는 이 사용자만 벌금이 없다 (거절이 쌓여도 지난 기간이 유지된다)
model UserRest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWeek  DateTime
  untilWeek DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 친구가 혼자 쉬는 주에 목표(주 3회)를 채운 사람이 받는 리본.
// 벌금이 생긴 주에 월요일 정산이 자동으로 1개를 써서 그 주 벌금을 면제한다 (가장 오래된 리본부터)
model Ribbon {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime // 리본을 받은 주
  usedWeek  DateTime? // 면제에 쓴 주 (null이면 아직 안 씀)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

model User {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  name      String
  createdAt DateTime @default(now())
  // 대결 카드 말풍선에 직접 정한 멘트 ([0]에 하나만 저장). 비어 있으면 인증 횟수별 기본 멘트
  captions  String[] @default([])
  // 같은 사람의 계정(여러 방)을 묶는 표시. 값이 같은 계정끼리는 한쪽에서 인증하면 다른 쪽에도 똑같이 인증된다
  linkGroup String?
  // 쉬어가기 요청을 친구가 거절("나라도 지킨다")했을 때: 요청한 사람만 이 기간(주 단위) 벌금이 면제된다
  rests UserRest[]
  ribbons Ribbon[]
  // 실험실: 식단 인증(AI 칼로리 분석) 켜기. 켠 사람만 식단 카드가 보이고 올릴 수 있다
  labMeal Boolean @default(false)
  meals   Meal[]
  // 아이폰 단축어(액션 버튼)로 식단 사진을 올릴 때 쓰는 개인 토큰. 쿠키가 없는 단축어가 "누구의 사진인지" 알려주는 용도
  mealToken String? @unique

  checkins      Checkin[]
  settlements   Settlement[]
  subscriptions PushSubscription[]
  excuses       Excuse[]
}

model Checkin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  photoUrl  String
  weekStart DateTime // 해당 인증이 속한 주의 월요일 00:00 (KST)
  liked     Boolean  @default(false) // 상대방이 칭찬(좋아요) 눌렀는지
  createdAt DateTime @default(now()) // 사진 촬영 시각(EXIF). 촬영 정보가 없으면 업로드 시각
}

// 실험실 식단 인증. 주 3회 운동 인증/벌금과는 별개로, 친구와 공유만 한다
model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl  String
  // AI 분석 결과 (분석 실패/키 없음이면 analyzed=false, 나머지는 비어 있다)
  analyzed  Boolean  @default(false)
  title     String? // 한 줄 요약 (예: 닭가슴살 샐러드)
  kcal      Int? // 추정 총 칼로리
  items     Json? // [{ name, kcal }]
  fraction  Float    @default(1) // 먹은 비율 (1=다 먹음, 0.5=절반). kcal은 items 합 × fraction
  confirmed Boolean  @default(true) // false면 단축어로 올라와 아직 본인이 확인하지 않은 초안. 확인 전에는 친구에게 안 보인다
  source    String   @default("app") // app | shortcut
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// 사람마다 하루에 AI를 몇 번 불렀는지 (크레딧을 한 사람이 너무 많이 쓰지 않게 하는 제한용). day는 오전 6시 기준 KST 날짜
model AiUsage {
  id     String @id @default(cuid())
  userId String
  day    String
  kind   String // photo(사진 분석) | text(이름으로 칼로리 계산)
  count  Int    @default(0)

  @@unique([userId, day, kind])
}

// 앱 전체가 이번 달에 AI로 쓴 크레딧 합계 (월 한도를 넘지 않게 하는 용도). month는 KST 기준 "2026-10"
model AiBudget {
  month   String @id
  credits Float  @default(0)
}

// 주간 마감 후 정산 상태만 저장 (횟수/벌금은 Checkin에서 즉시 계산)
model Settlement {
  id        String    @id @default(cuid())
  weekStart DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  settled   Boolean   @default(false)
  settledAt DateTime?

  @@unique([weekStart, userId])
}

// "사정 봐달라하기" 요청 (한 달에 한 번). 상대방이 허락하면 그 주 벌금이 전액 면제된다
model Excuse {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  weekStart  DateTime
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reply      String?   // 허락/거절하면서 상대방이 남긴 답장 (선택)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
