generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1:1 맞짱 방. 초대 링크(inviteToken)로 친구를 초대해서 최대 2명까지 들어옴
model Room {
  id          String   @id @default(cuid())
  inviteToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  // 벌금을 모으는 모임 통장 (개인 계좌가 아니라 방 하나당 공용 계좌 하나)
  groupBankName      String?
  groupAccountNumber String?
  groupAccountHolder String?

  // 방 삭제 요청 (상호 동의 방식)
  deleteRequestedBy String? // 삭제 요청한 userId

  // 일시정지 (상호 동의 방식)
  pauseRequestedBy    String?   // 정지 요청한 userId
  pauseRequestedUntil DateTime? // 요청된 정지 종료일
  pausedUntil         DateTime? // 확정된 정지 종료일 (null이면 정지 아님)

  users User[]
}

model User {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  name      String
  createdAt DateTime @default(now())
  // 대결 카드 말풍선에 직접 정한 멘트 ([0]에 하나만 저장). 비어 있으면 인증 횟수별 기본 멘트
  captions  String[] @default([])
  // 같은 사람의 계정(여러 방)을 묶는 표시. 값이 같은 계정끼리는 한쪽에서 인증하면 다른 쪽에도 똑같이 인증된다
  linkGroup String?

  checkins      Checkin[]
  settlements   Settlement[]
  subscriptions PushSubscription[]
  excuses       Excuse[]
}

model Checkin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  photoUrl  String
  weekStart DateTime // 해당 인증이 속한 주의 월요일 00:00 (KST)
  liked     Boolean  @default(false) // 상대방이 칭찬(좋아요) 눌렀는지
  createdAt DateTime @default(now()) // 사진 촬영 시각(EXIF). 촬영 정보가 없으면 업로드 시각
}

// 주간 마감 후 정산 상태만 저장 (횟수/벌금은 Checkin에서 즉시 계산)
model Settlement {
  id        String    @id @default(cuid())
  weekStart DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  settled   Boolean   @default(false)
  settledAt DateTime?

  @@unique([weekStart, userId])
}

// "사정 봐달라하기" 요청 (한 달에 한 번). 상대방이 허락하면 그 주 벌금이 전액 면제된다
model Excuse {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  weekStart  DateTime
  reason     String
  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reply      String?   // 허락/거절하면서 상대방이 남긴 답장 (선택)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
